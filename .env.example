# Prodaco Services — environment variables
# Copy to `.env` for local dev, or paste each key into Railway → Variables for prod.
# Never commit real secrets.

# ---- Core ---------------------------------------------------------------
# Port to listen on. Railway injects this automatically — leave unset in prod.
PORT=3000

# Absolute path to the SQLite leads database.
# Prod: /data/prodaco.db  (must be on a Railway Volume)
# Dev:  ./prodaco.db      (or leave unset — defaults next to server.js)
DB_PATH=./prodaco.db

# ---- Email (Resend HTTPS API — SMTP is blocked on Railway) --------------
# https://resend.com — verify prodacoservices.com domain first.
RESEND_API_KEY=
MAIL_FROM=info@prodacoservices.com
INFO_INBOX=info@prodacoservices.com
